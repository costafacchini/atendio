PORT=5001
NODE_ENV=development
DEFAULT_USER=user@test.com
DEFAULT_PASSWORD=12345678
SECRET=change-me
REDIS_URL=redis://127.0.0.1:6381
API_PROXY_TARGET=http://127.0.0.1:5001

STORAGE_PROVIDER=local       # local | s3 (default: s3)
LOCAL_STORAGE_PATH=/app/uploads  # only used when STORAGE_PROVIDER=local
APP_URL=http://localhost:5001    # used by LocalStorage to build public file URLs
SKIP_PREFLIGHT_CHECK=true #HEROKU ONLY

# Postgres credentials
# Local dev: see postgres service in docker-compose.yml (mapped to host port 5438)
DATABASE_URL="postgresql://postgres:postgres@localhost:5438/atendio?schema=public"
# Set to '1' when Postgres is running to enable integration tests
RUN_POSTGRES_TESTS=""

# AWS S3 credentials
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
