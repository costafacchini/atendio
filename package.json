{
  "name": "atendio",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "author": "Alan Costa Facchini",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node --require source-map-support/register --require './appsignal.cjs' dist/server.js",
    "build": "npx prisma generate && tsc && echo '{\"type\":\"commonjs\"}' > dist/package.json && cp appsignal.cjs dist/appsignal.cjs && cd client && yarn install --production=false && yarn run build && cd ../widget && yarn install --frozen-lockfile --production=false && yarn build",
    "dev": "npm-run-all -p dev:*",
    "dev:server": "nodemon --exec tsx server.ts",
    "dev:worker": "nodemon --exec tsx worker.ts",
    "smoke:start": "node src/scripts/smoke/start.mjs",
    "smoke:check": "node src/scripts/smoke/check.mjs",
    "smoke:stop": "node src/scripts/smoke/stop.mjs",
    "test": "NODE_ENV=test jest --config=jest.config.mjs --no-coverage --maxWorkers=50%",
    "test:ci": "NODE_ENV=test jest --config=jest.config.mjs",
    "test:coverage": "NODE_ENV=test jest --config=jest.config.mjs --maxWorkers=50%",
    "watch": "NODE_ENV=test jest --no-coverage --verbose --watch --runInBand --notify --notifyMode always",
    "linter": "yarn eslint 'src/app/**/*.{js,ts,tsx}' 'src/config/**/*.{js,ts,tsx}'",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "build:fly": "tsc && echo '{\"type\":\"commonjs\"}' > dist/package.json && cp appsignal.cjs dist/appsignal.cjs",
    "start:fly": "sh start-combined.sh"
  },
  "devDependencies": {
    "@babel/core": "^8.0.0",
    "@babel/plugin-transform-modules-commonjs": "^8.0.0",
    "@babel/preset-env": "^8.0.0",
    "@babel/preset-typescript": "8.0.1",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.1",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "6.0.0",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/morgan": "1.9.10",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "@typescript-eslint/eslint-plugin": "8.68.0",
    "@typescript-eslint/parser": "8.68.0",
    "@typescript-eslint/utils": "^8.58.0",
    "babel-jest": "^30.2.0",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-config-standard": "17.1.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jest": "29.16.5",
    "eslint-plugin-jest-dom": "5.10.1",
    "eslint-plugin-n": "18.3.0",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-promise": "7.3.0",
    "jest": "30.4.2",
    "jest-date-mock": "1.0.10",
    "mongodb-memory-server": "11.2.0",
    "npm-run-all2": "9.0.3",
    "prettier": "3.9.6",
    "supertest": "7.2.2",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@appsignal/nodejs": "^3.8.0",
    "@aws-sdk/client-ecs": "3.1120.0",
    "@aws-sdk/client-s3": "^3.32.0",
    "@aws-sdk/s3-request-presigner": "^3.32.0",
    "@bull-board/api": "^9.0.0",
    "@bull-board/express": "^9.0.0",
    "@bull-board/ui": "^9.0.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@sentry/node": "^10.25.0",
    "@socket.io/redis-adapter": "8.3.0",
    "@socket.io/redis-emitter": "5.1.0",
    "@whiskeysockets/baileys": "^7.0.0-rc.9",
    "archiver": "8.0.0",
    "bcrypt": "6.0.0",
    "bullmq": "6.3.1",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "debug": "4.4.3",
    "dotenv": "17.4.2",
    "esm-module-alias": "^2.2.1",
    "express": "5.2.1",
    "express-rate-limit": "8.6.2",
    "express-validator": "7.3.2",
    "fishery": "2.4.0",
    "helmet": "8.3.0",
    "http-errors": "2.0.1",
    "ioredis": "^6.0.0",
    "isomorphic-fetch": "3.0.0",
    "jsonwebtoken": "9.0.3",
    "lodash": "4.18.1",
    "module-alias": "2.3.4",
    "moment": "2.30.1",
    "moment-timezone": "0.6.3",
    "morgan": "1.11.0",
    "newrelic": "14.3.9",
    "node-notifier": "10.0.1",
    "nodemon": "3.1.14",
    "pg": "8.23.0",
    "prisma": "7.10.0",
    "rate-limit-redis": "6.0.1",
    "rollbar": "3.1.0",
    "socket.io": "4.8.3",
    "source-map-support": "^0.5.21",
    "tsx": "4.23.12",
    "uuid": "14.0.2",
    "yarn": "1.22.22"
  },
  "_moduleAliases": {
    "@models": "./src/app/models",
    "@controllers": "./src/app/controllers",
    "@routes": "./src/app/routes",
    "@config": "./src/config",
    "@queries": "./src/app/queries",
    "@reports": "./src/app/reports",
    "@helpers": "./src/app/helpers",
    "@plugins": "./src/app/plugins",
    "@repositories": "./src/app/repositories"
  },
  "resolutions": {
    "lodash": "4.18.1",
    "@typescript-eslint/utils": "^8.58.0",
    "uuid": "14.0.2",
    "socket.io-parser": "4.2.7",
    "tar": "7.5.22",
    "shell-quote": "1.10.0",
    "postcss": "8.5.26",
    "undici": "8.10.0",
    "ip-address": "10.5.0",
    "protobufjs": "8.8.0",
    "@opentelemetry/core": "2.10.0",
    "@opentelemetry/propagator-jaeger": "2.10.0",
    "@eslint/eslintrc/js-yaml": "5.4.1"
  }
}
