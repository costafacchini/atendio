NODE_ENV=production
PORT=5000

# Secrets — fill in before running
SECRET=

# Infrastructure — Docker service names (do not use localhost here)
REDIS_URL=redis://redis:6379
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/atendio?schema=public"

# Storage
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=/app/uploads
APP_URL=http://localhost:5100
CLIENT_PORT=5100

# Features
ENABLE_MESSENGERS=true
ENABLE_CHATS=true
ENABLE_BAILEYS_SOCKET=false
SKIP_PREFLIGHT_CHECK=true
