NODE_ENV=production
PORT=5000

# Secrets — fill in before running
SECRET=

# Infrastructure — Docker service names (do not use localhost here)
REDIS_URL=redis://redis:6379
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/atendio?schema=public"

# Storage
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=/app/uploads
APP_URL=http://localhost:5100
CLIENT_PORT=5100

# Storage — S3/MinIO alternative (set STORAGE_PROVIDER=s3 to use)
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin
# AWS_BUCKET_NAME=atendio-prod
# AWS_DEFAULT_REGION=us-east-1
# AWS_ENDPOINT_URL=http://host.docker.internal:9000
# AWS_PUBLIC_URL=http://localhost:9000

# Features
ENABLE_MESSENGERS=true
ENABLE_CHATS=true
ENABLE_BAILEYS_SOCKET=false
SKIP_PREFLIGHT_CHECK=true
